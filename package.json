{
  "name": "escritorio-advocacia",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run styles && node scripts/render.mjs && vite --host 127.0.0.1",
    "build": "npm run styles && node scripts/render.mjs && vite build && node scripts/check-build.mjs",
    "styles": "node scripts/styles.mjs",
    "styles:watch": "node scripts/styles.mjs --watch",
    "preview": "vite preview --host 127.0.0.1",
    "check": "node scripts/check-build.mjs"
  },
  "dependencies": {
    "@fontsource/cormorant-garamond": "^5.2.0",
    "@fontsource/inter": "^5.2.0",
    "gsap": "^3.13.0",
    "lenis": "^1.3.0"
  },
  "devDependencies": {
    "playwright": "^1.56.0",
    "sass": "^1.93.0",
    "vite": "^7.2.0"
  }
}
